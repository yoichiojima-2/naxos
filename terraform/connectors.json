{
  "slack": {
    "upstream_image": "ghcr.io/korotovsky/slack-mcp-server:latest",
    "args": ["mcp-server", "--transport", "sse"],
    "secret_env": ["SLACK_MCP_XOXP_TOKEN"],
    "env": {}
  },
  "atlassian": {
    "upstream_image": "ghcr.io/sooperset/mcp-atlassian:latest",
    "args": ["--transport", "streamable-http", "--port", "8080"],
    "secret_env": ["JIRA_API_TOKEN", "CONFLUENCE_API_TOKEN"],
    "env": {
      "JIRA_URL": "",
      "JIRA_USERNAME": "",
      "CONFLUENCE_URL": "",
      "CONFLUENCE_USERNAME": ""
    }
  },
  "notion": {
    "upstream_image": "mcp/notion:latest",
    "args": [],
    "secret_env": ["NOTION_TOKEN"],
    "env": {
      "AUTH_TYPE": "internal"
    }
  },
  "gworkspace": {
    "upstream_image": "ghcr.io/taylorwilsdon/google_workspace_mcp:latest",
    "args": ["--transport", "streamable-http"],
    "secret_env": [],
    "env": {
      "GOOGLE_MCP_CREDENTIALS_MODE": "service_account",
      "WORKSPACE_MCP_PORT": "8080"
    }
  }
}
